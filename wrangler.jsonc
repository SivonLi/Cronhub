{
  "name": "cronjob",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  // SchedulerAlarm 每分钟自动唤醒，任务时间由 Cronhub 数据库中的规则决定。
  "triggers": { "crons": [] },
  "durable_objects": {
    "bindings": [{ "name": "SCHEDULER", "class_name": "SchedulerAlarm" }]
  },
  "exports": {
    "SchedulerAlarm": { "type": "durable-object", "storage": "sqlite" }
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cronjob_db"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
